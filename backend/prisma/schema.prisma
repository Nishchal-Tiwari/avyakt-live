generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classesAsTeacher Class[]       @relation("TeacherClasses")
  invites          ClassInvite[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  teacher     User     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomName    String   @unique
  redirectUrl String?  // optional URL to redirect when meeting ends or user disconnects
  /// When true, students must keep the camera on to use the meeting UI.
  requireCamera Boolean @default(false)
  /// When true, students must keep the microphone on to use the meeting UI.
  requireMic    Boolean @default(false)
  /// When true, students see a host-present attendance streak for this class.
  streakEnabled   Boolean @default(false)
  /// Number of consecutive qualifying class days (see streak rules) to complete the goal.
  streakTargetDays Int    @default(21)

  invites              ClassInvite[]
  attendance           Attendance[]
  attendanceDaily      ClassAttendanceDaily[]
}

model ClassInvite {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  email     String
  invitedBy String
  inviter   User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, email])
  @@index([classId])
  @@index([email])
}

model Attendance {
  id        String    @id @default(cuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  email     String
  joinTime  DateTime  @default(now())
  leaveTime DateTime?
  duration  Int?      // seconds

  @@index([classId])
  @@index([email])
}

/// Credited seconds per student per calendar day (UTC), only while host + student are in the LiveKit room.
model ClassAttendanceDaily {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  email     String
  day       DateTime @db.Date
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, email, day])
  @@index([classId])
  @@index([email])
}
